#!/bin/sh
set -eu

# `.xcstrings` has one writer, `xcrun xcstringstool`, which separates key from
# value as `"key" : value`. Every other JSON tool writes `"key":`, rewriting all
# ten thousand lines and burying the real change. This REFUSES rather than
# repairs: the separator could be restored with sed, but key ORDER could not —
# plutil sorts case-insensitively where xcstringstool sorts by byte, so a
# repair would be right by accident and wrong silently. Checked before the
# early exit below, which returns when a commit touches no Swift file.
for catalog in $(git diff --cached --name-only --diff-filter=ACM -- '*.xcstrings'); do
    grep -qE '^[[:space:]]*"[^"]*":[[:space:]]' "$catalog" || continue
    echo "pre-commit: $catalog was not written by xcstringstool." >&2
    echo "            A JSON formatter has rewritten it; the next sync would flip every line back." >&2
    echo "            Recover with: git checkout -- $catalog && ./scripts/sync-strings.sh" >&2
    exit 1
done

# ThemeTokens.swift is generated by Tools/GenerateTokens.swift and is compared
# against Design/tokens.json by DesignTokenTests; formatting it fails that check.
files=$(git ls-files '*.swift' | grep -v 'App/Vocula/UI/ThemeTokens.swift')
[ -n "$files" ] || exit 0

xcrun swift-format --in-place --parallel $files

# Only files the commit already touches are re-staged, so an unrelated edit
# reformatted in the working tree is not swept into this commit.
staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.swift' \
         | grep -v 'App/Vocula/UI/ThemeTokens.swift' || true)
[ -n "$staged" ] && git add -- $staged
exit 0

    "onboarding.globeKey.explanation" : {
      "comment" : "Why the globe key must be set to do nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sonst nimmt das System die Taste für sein eigenes Diktat oder für die Emoji-Auswahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Otherwise the system takes the key for its own dictation or the emoji picker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si no, el sistema se queda la tecla para su propio dictado o para el selector de emojis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinon le système prend la touche pour sa propre dictée ou pour le sélecteur d’émojis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Altrimenti il sistema si prende il tasto per la propria dettatura o per il selettore di emoji."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "W przeciwnym razie system zabierze klawisz na własne dyktowanie albo na wybór emoji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caso contrário o sistema fica com a tecla para o próprio ditado ou para o seletor de emoji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Иначе система заберёт клавишу под собственную диктовку или панель эмодзи."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Інакше система забере клавішу під власне диктування або панель емодзі."
          }
        }
      }
    },
    "onboarding.globeKey.title" : {
      "comment" : "Row title. This is macOS's own setting name, verbatim from its Keyboard pane, and 🌐 is the key's own glyph.",

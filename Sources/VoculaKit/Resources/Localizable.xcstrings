    "onboarding.accessibility.explanation" : {
      "comment" : "Why Accessibility is needed. ⌘V is a key chord and is never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Damit ⌘V an eine andere App gesendet werden kann und damit wir fragen können, ob das aktive Feld ein sicheres ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "So ⌘V can be sent to another application, and so we can ask whether the focused field is a secure one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para poder enviar ⌘V a otra app y para poder preguntar si el campo activo es seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pour pouvoir envoyer ⌘V à une autre app et pour pouvoir demander si le champ actif est sécurisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Per poter inviare ⌘V a un’altra app e per poter chiedere se il campo attivo è protetto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aby ⌘V mogło zostać wysłane do innego programu i aby można było zapytać, czy aktywne pole jest chronione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para que ⌘V possa ser enviado a outro app e para que possamos perguntar se o campo em foco é seguro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Чтобы ⌘V можно было отправить в другую программу и чтобы можно было спросить, защищено ли активное поле."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Щоб ⌘V можна було надіслати в іншу програму і щоб можна було запитати, чи є активне поле захищеним."
          }
        }
      }
    },

    "refusal.recovery.historyOff" : {
      "comment" : "As refusal.recovery.historyOn but with history off. MUST NOT mention History: with recording off the text is not there, and saying so is a privacy statement.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwenden Sie „Letztes Transkript kopieren“ — die Verlaufsaufzeichnung ist aus, der Text wird also nicht gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Use Copy the last transcript — history recording is off, so it is not saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa «Copiar la última transcripción»: el registro del historial está desactivado, así que no se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez « Copier la dernière transcription » — l’enregistrement de l’historique est désactivé, le texte n’est donc pas conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa «Copia l’ultima trascrizione»: la registrazione della cronologia è disattivata, quindi il testo non viene salvato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj „Kopiuj ostatnią transkrypcję” — zapis historii jest wyłączony, więc tekst nie zostaje zachowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use “Copiar a última transcrição” — o registro do histórico está desligado, então ela não fica salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Возьмите «Скопировать последний текст» — запись истории выключена, поэтому текст не сохранён."

    "binding.rejected.escape" : {
      "comment" : "Why Esc cannot be bound. Esc is a key name and is not translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc bricht eine Aufnahme ab. Diese Taste zu belegen würde Abbrechen und Starten ununterscheidbar machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Esc cancels a recording. Binding to it would make cancelling indistinguishable from starting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc cancela una grabación. Asignarla haría que cancelar fuese indistinguible de empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc annule un enregistrement. L’affecter rendrait l’annulation indiscernable du démarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc annulla una registrazione. Assegnarlo renderebbe l’annullamento indistinguibile dall’avvio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc anuluje nagranie. Przypisanie go sprawiłoby, że anulowanie byłoby nie do odróżnienia od rozpoczęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc cancela uma gravação. Atribuí-la tornaria cancelar indistinguível de começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esc отменяет запись. Назначение на неё сделало бы отмену неотличимой от начала."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",

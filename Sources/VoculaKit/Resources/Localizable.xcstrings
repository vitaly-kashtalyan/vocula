    "refusal.silentInput.deadDevice" : {
      "comment" : "A dead input device, NOT a quiet room. Fixed by a different action from refusal.silentInput.volumeDown, so the two must not converge. Microphone is this app's own section name. — the indicator caps at three lines and cuts anything longer. Drawn on the indicator strip, which clamps at three lines; IndicatorChipSizeTests measures every locale against it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kein Signal vom Mikrofon. Prüfen Sie Voculas Mikrofon-Einstellungen — ein nur zur Wiedergabe verbundenes Headset nimmt nichts auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No signal at all from the microphone. Check Vocula’s Microphone settings — a headset connected only for playback records nothing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El micrófono no dio señal alguna. Revisa los ajustes de Micrófono de Vocula: unos auriculares conectados solo para reproducir no graban nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun signal du microphone. Vérifiez les réglages Microphone de Vocula — un casque connecté seulement en lecture n’enregistre rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessun segnale dal microfono. Controlla le impostazioni Microfono di Vocula: cuffie collegate solo per la riproduzione non registrano nulla."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Brak sygnału z mikrofonu. Sprawdź ustawienia Mikrofonu w Voculi — słuchawki podłączone tylko do odtwarzania nie nagrywają nic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhum sinal do microfone. Confira os ajustes de Microfone do Vocula — um fone conectado só para reprodução não grava nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Микрофон не дал сигнала. Проверьте раздел «Микрофон» — гарнитура только для воспроизведения не пишет ничего."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мікрофон не дав сигналу. Перевірте розділ «Мікрофон» — гарнітура лише для відтворення не записує нічого."
          }
        }
      }
    },
    "refusal.silentInput.volumeDown" : {
      "comment" : "The system input level is at zero. The pane path is macOS's own and comes from the glossary.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {

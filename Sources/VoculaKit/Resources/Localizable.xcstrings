          }
        }
      }
    },
    "binding.warning.appleStandard" : {
      "comment" : "Warning that a standard macOS shortcut is being taken over.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS gibt diesem Kurzbefehl in jeder App eine feste Bedeutung. Ihn hier zu belegen nimmt ihn allen anderen weg."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "macOS gives this shortcut a standard meaning in every app. Binding it here takes it away from all of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS da a esta combinación un significado estándar en todas las apps. Ocuparla aquí se la quita a todas ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS donne à ce raccourci un sens standard dans toutes les apps. L’occuper ici le retire à toutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS dà a questa combinazione un significato standard in ogni app. Occuparla qui la toglie a tutte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS nadaje temu skrótowi standardowe znaczenie w każdym programie. Zajęcie go tutaj odbiera go im wszystkim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O macOS dá a este atalho um significado padrão em todos os apps. Ocupá-lo aqui o tira de todos eles."
          }
        },
        "ru" : {
          "stringUnit" : {

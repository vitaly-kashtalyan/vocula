    "binding.rejected.bareKey" : {
      "comment" : "Why a key with no modifiers cannot be bound.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine normale Taste ohne Sondertasten: Tippen würde zum Diktieren werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An ordinary key with no modifiers: typing would become dictation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una tecla normal sin modificadores: escribir se convertiría en dictar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une touche ordinaire sans modificateur : taper deviendrait dicter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un tasto normale senza modificatori: digitare diventerebbe dettare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zwykły klawisz bez modyfikatorów: pisanie stałoby się dyktowaniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Uma tecla comum sem modificadores: digitar viraria ditar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Обычная клавиша без модификаторов: набор текста превратился бы в диктовку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Звичайна клавіша без модифікаторів: набір тексту перетворився б на диктування."
          }
        }
      }
    },
    "binding.rejected.capsLock" : {
      "comment" : "Why Caps Lock cannot be bound. Load-bearing: this row has no footer of its own and carries the whole explanation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Feststelltaste lässt sich nicht belegen: Das System behandelt sie besonders, mit eigener Rastung und Verzögerung. Sie zu einer gewöhnlichen Taste zu machen erfordert eine Umbelegung auf Treiberebene — das ist eine Einstellung des Geräts, nicht dieser App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Caps Lock cannot be assigned: the system treats it specially, with latching and a delay of its own. Turning it into an ordinary key needs driver-level remapping — that is a setting of the machine, not of this app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bloq Mayús no se puede asignar: el sistema la trata de forma especial, con enclavamiento y un retardo propio. Convertirla en una tecla normal exige reasignarla a nivel de controlador, y eso es un ajuste de la máquina, no de esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verr. maj. ne peut pas être affectée : le système la traite à part, avec un verrouillage et un délai qui lui sont propres. En faire une touche ordinaire exige un remappage au niveau du pilote, ce qui est un réglage de la machine et non de cette app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Blocco maiuscole non è assegnabile: il sistema lo tratta in modo speciale, con un blocco e un ritardo propri. Renderlo un tasto normale richiede una rimappatura a livello di driver, che è un’impostazione della macchina e non di questa app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caps Lock nie może zostać przypisany: system traktuje go szczególnie, z własną blokadą i opóźnieniem. Uczynienie z niego zwykłego klawisza wymaga przemapowania na poziomie sterownika — a to ustawienie maszyny, nie tego programu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A Caps Lock não pode ser atribuída: o sistema a trata de forma especial, com travamento e atraso próprios. Torná-la uma tecla comum exige remapeamento no nível do driver — isso é um ajuste da máquina, não deste app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caps Lock назначить нельзя: система обращается с ней особым образом — с фиксацией и собственной задержкой. Сделать её обычной клавишей можно только переназначением на уровне драйвера, а это настройка машины, а не этой программы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Caps Lock призначити не можна: система поводиться з нею особливо — з фіксацією та власною затримкою. Зробити її звичайною клавішею можна лише перепризначенням на рівні драйвера, а це налаштування машини, а не цієї програми."
          }
        }
      }
    },
    "binding.rejected.commandQ" : {
      "comment" : "Why ⌘Q cannot be bound.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌘Q beendet die App. Eine App, die ⌘Q kaputt macht, ist kaputt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌘Q quits the application. An app that breaks ⌘Q is a broken app."

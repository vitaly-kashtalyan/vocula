    "livecheck.nothingArrived" : {
      "comment" : "Live-check result: nothing reached the tap. The four app names are products and are never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Taste kommt gar nicht an. Wahrscheinliche Ursachen: Ein anderes Programm fängt sie ab (Raycast, Alfred, Karabiner, BetterTouchTool, ein Firmen-Agent), die Firmware einer externen Tastatur, oder die sichere Eingabe ist gerade aktiv. Wählen Sie eine andere Taste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The key does not arrive at all. Likely causes: another interceptor took it (Raycast, Alfred, Karabiner, BetterTouchTool, a corporate agent), external keyboard firmware, or secure input is active right now. Choose another key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tecla no llega en absoluto. Causas probables: otra app la intercepta (Raycast, Alfred, Karabiner, BetterTouchTool, un agente corporativo), el firmware de un teclado externo, o la entrada segura está activa ahora mismo. Elige otra tecla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La touche n’arrive pas du tout. Causes probables : une autre app l’intercepte (Raycast, Alfred, Karabiner, BetterTouchTool, un agent d’entreprise), le micrologiciel d’un clavier externe, ou la saisie sécurisée est active en ce moment. Choisissez une autre touche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il tasto non arriva affatto. Cause probabili: un’altra app lo intercetta (Raycast, Alfred, Karabiner, BetterTouchTool, un agente aziendale), il firmware di una tastiera esterna, oppure l’input sicuro è attivo in questo momento. Scegli un altro tasto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klawisz w ogóle nie dochodzi. Prawdopodobne przyczyny: przechwytuje go inny program (Raycast, Alfred, Karabiner, BetterTouchTool, agent firmowy), oprogramowanie zewnętrznej klawiatury albo właśnie działa bezpieczne wprowadzanie. Wybierz inny klawisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A tecla não chega de jeito nenhum. Causas prováveis: outro app a intercepta (Raycast, Alfred, Karabiner, BetterTouchTool, um agente corporativo), o firmware de um teclado externo, ou a entrada segura está ativa agora. Escolha outra tecla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавиша не доходит вовсе. Вероятные причины: её перехватила другая программа (Raycast, Alfred, Karabiner, BetterTouchTool, корпоративный агент), прошивка внешней клавиатуры, либо прямо сейчас включён защищённый ввод. Выберите другую клавишу."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавіша не доходить узагалі. Ймовірні причини: її перехоплює інша програма (Raycast, Alfred, Karabiner, BetterTouchTool, корпоративний агент), прошивка зовнішньої клавіатури, або просто зараз увімкнено захищене введення. Оберіть іншу клавішу."
          }
        }
      }
    },
    "livecheck.pressWithoutRelease" : {

          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula n’enregistre le son des autres apps que pendant que vous enregistrez une réunion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula registra l’audio delle altre app solo mentre registri una riunione."

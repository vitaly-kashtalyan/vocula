  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "comment" : "macOS's own permission prompt for System Audio Recording — the first thing a user reads about it, before any meeting line of ours. It must say when recording happens and nothing more; a longer sentence is truncated by the system dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula nimmt den Ton anderer Apps nur auf, während Sie ein Meeting aufnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocula records other apps' sound only while you record a meeting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula graba el sonido de otras apps solo mientras grabas una reunión."
          }
        },

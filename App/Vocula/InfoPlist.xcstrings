  "strings" : {
    "NSMicrophoneUsageDescription" : {
      "comment" : "The FIRST English a user ever sees — macOS's own microphone permission dialog, before any window of ours. It must say when recording happens and nothing more; a longer sentence is truncated by the system dialog.",

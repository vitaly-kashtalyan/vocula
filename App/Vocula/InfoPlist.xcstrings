    "NSMicrophoneUsageDescription" : {
      "comment" : "The FIRST English a user ever sees — macOS's own microphone permission dialog, before any window of ours. It must say when recording happens and nothing more; a longer sentence is truncated by the system dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula nimmt nur Audio auf, während Sie diktieren oder ein Meeting aufnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vocula records audio only while you dictate or record a meeting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula graba audio solo mientras dictas o grabas una reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula n’enregistre du son que pendant que vous dictez ou enregistrez une réunion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula registra audio solo mentre detti o registri una riunione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula nagrywa dźwięk tylko wtedy, gdy dyktujesz lub nagrywasz spotkanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

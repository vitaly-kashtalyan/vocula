            "value" : "Vocula is running from the disk image"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula se está ejecutando desde la imagen de disco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula est lancée directement depuis l’image disque"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula è in esecuzione direttamente dall’immagine disco"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula działa bezpośrednio z obrazu dysku"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Vocula está sendo executado diretamente da imagem de disco"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula запущена прямо из образа диска"
          }
        },
        "uk" : {

          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo instalar la tecla de grabación, así que la combinación no hace nada. Concede la Accesibilidad en %@ y reinicia Vocula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La touche d’enregistrement n’a pas pu être installée, le raccourci ne fait donc rien. Accordez l’Accessibilité dans %@, puis redémarrez Vocula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stato possibile installare il tasto di registrazione, quindi la combinazione non fa nulla. Concedi l'accessibilità in %@, poi riavvia Vocula."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się zainstalować klawisza nagrywania, więc skrót nic nie robi. Przyznaj Dostępność w %@, a następnie uruchom Voculę ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível instalar a tecla de gravação, então o atalho não faz nada. Conceda a Acessibilidade em %@ e reinicie o Vocula."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавишу записи не удалось установить, поэтому сокращение ничего не делает. Выдайте Универсальный доступ: %@, затем перезапустите Vocula."
          }

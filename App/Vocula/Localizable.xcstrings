    "refinement.pastesAsRecognised" : {
      "comment" : "Footer under the clean-up switch while the switch is on and its model is not on this Mac, alone in that footer. \"The model below\" is the clean-up model's row, further down this screen, below the maximum-wait picker. Also spoken by VoiceOver on its own, as the switch's hint.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bis das Modell unten heruntergeladen ist, werden Diktate so eingefügt, wie sie erkannt wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Until the model below is downloaded, dictations are pasted as they were recognised."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasta que se descargue el modelo de abajo, los dictados se pegan tal como se reconocieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tant que le modèle ci-dessous n’est pas téléchargé, les dictées sont collées telles qu’elles ont été reconnues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Finché il modello qui sotto non è scaricato, le dettature vengono incollate così come sono state riconosciute."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dopóki model poniżej nie zostanie pobrany, dyktowany tekst jest wklejany tak, jak został rozpoznany."

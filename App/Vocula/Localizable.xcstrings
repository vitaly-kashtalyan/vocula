    "menu.tapInstallFailed" : {
      "comment" : "Menu bar message; the argument is a macOS System Settings pane path.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Aufnahmetaste ließ sich nicht einrichten, der Kurzbefehl tut also nichts. Erteilen Sie die Bedienungshilfen unter %@ und starten Sie Vocula neu."
          }
        },
        "en" : {
          "stringUnit" : {

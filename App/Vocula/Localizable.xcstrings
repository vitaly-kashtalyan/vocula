    "menu.keyLoss" : {
      "comment" : "Menu bar message when the event tap kept being disabled.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Ereignisüberwachung wurde wiederholt deaktiviert; Tastenereignisse sind möglicherweise verloren gegangen. Öffnen Sie die Tasteneinstellungen und führen Sie die Live-Prüfung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The event monitor was repeatedly disabled; key events may have been missed. Open the binding settings and run the live check."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El monitor de eventos se desactivó repetidamente; pueden haberse perdido eventos de teclado. Abre los ajustes de asignación y ejecuta la comprobación en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le moniteur d’évènements a été désactivé à plusieurs reprises ; des évènements clavier ont pu être perdus. Ouvrez les réglages d’affectation et lancez la vérification en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il monitor eventi è stato disattivato ripetutamente; alcuni eventi di tastiera potrebbero essere andati persi. Apri le impostazioni di assegnazione ed esegui la verifica dal vivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Monitor zdarzeń był wielokrotnie wyłączany; zdarzenia klawiatury mogły zostać zgubione. Otwórz ustawienia przypisań i uruchom sprawdzenie na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O monitor de eventos foi desativado repetidamente; eventos de teclado podem ter se perdido. Abra os ajustes de atribuição e execute a verificação ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монитор событий многократно отключался; события клавиатуры могли теряться. Откройте настройки привязок и выполните живую проверку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монітор подій багаторазово вимикався; події клавіатури могли загубитися. Відкрийте параметри прив’язок і виконайте живу перевірку."
          }
        }
      }
    },
    "menu.keyLoss.secureInput" : {
      "comment" : "As menu.keyLoss, but secure input was on at the time.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Ereignisüberwachung wurde wiederholt deaktiviert; Tastenereignisse sind möglicherweise verloren gegangen. Die sichere Eingabe ist gerade aktiv. Öffnen Sie die Tasteneinstellungen und führen Sie die Live-Prüfung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The event monitor was repeatedly disabled; key events may have been missed. Secure input is currently active. Open the binding settings and run the live check."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El monitor de eventos se desactivó repetidamente; pueden haberse perdido eventos de teclado. La entrada segura está activa ahora mismo. Abre los ajustes de asignación y ejecuta la comprobación en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le moniteur d’évènements a été désactivé à plusieurs reprises ; des évènements clavier ont pu être perdus. La saisie sécurisée est active en ce moment. Ouvrez les réglages d’affectation et lancez la vérification en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il monitor eventi è stato disattivato ripetutamente; alcuni eventi di tastiera potrebbero essere andati persi. L’input sicuro è attivo in questo momento. Apri le impostazioni di assegnazione ed esegui la verifica dal vivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Monitor zdarzeń był wielokrotnie wyłączany; zdarzenia klawiatury mogły zostać zgubione. Właśnie działa bezpieczne wprowadzanie. Otwórz ustawienia przypisań i uruchom sprawdzenie na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O monitor de eventos foi desativado repetidamente; eventos de teclado podem ter se perdido. A entrada segura está ativa agora. Abra os ajustes de atribuição e execute a verificação ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монитор событий многократно отключался; события клавиатуры могли теряться. Прямо сейчас включён защищённый ввод. Откройте настройки привязок и выполните живую проверку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Монітор подій багаторазово вимикався; події клавіатури могли загубитися. Просто зараз увімкнено захищене введення. Відкрийте параметри прив’язок і виконайте живу перевірку."
          }
        }
      }
    },

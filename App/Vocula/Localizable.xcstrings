    "licence.offlineCheck" : {
      "comment" : "A privacy claim about the product: LICENCE VERIFICATION is offline, and must keep saying so. Do NOT widen it to the whole app — the model download and the update check both use the network.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula prüft Ihren Schlüssel auf diesem Mac, ohne jede Netzwerkverbindung — genau wie alles andere, was die App tut. Deshalb gibt es keine Anmeldung, kein Konto und keine Begrenzung, auf wie vielen eigenen Macs eine Lizenz gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vocula checks your key on this Mac, with no network connection at all. That is why there is no sign-in, no account, and no limit on how many of your own Macs one licence will open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula comprueba tu clave en este Mac, sin ninguna conexión de red, igual que todo lo demás que hace. Por eso no hay inicio de sesión, ni cuenta, ni límite en cuántos Mac tuyos abre una misma licencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula vérifie votre clé sur ce Mac, sans aucune connexion réseau — comme tout le reste de ce qu’elle fait. C’est pourquoi il n’y a ni connexion, ni compte, ni limite au nombre de vos propres Mac qu’une licence ouvre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula verifica la tua chiave su questo Mac, senza alcuna connessione di rete — come tutto il resto di ciò che fa. Per questo non c’è accesso, non c’è account e non c’è limite a quanti dei tuoi Mac apre una sola licenza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula sprawdza Twój klucz na tym Macu, bez żadnego połączenia sieciowego — tak jak wszystko inne, co robi. Dlatego nie ma logowania, nie ma konta i nie ma ograniczenia, ile Twoich własnych Maców otworzy jedna licencja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Vocula verifica sua chave neste Mac, sem nenhuma conexão de rede — igual a tudo o mais que ele faz. É por isso que não há login, não há conta e não há limite de quantos Macs seus uma licença abre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula проверяет ваш ключ на этом Mac, без какого-либо сетевого соединения — как и всё остальное, что она делает. Поэтому нет ни входа в учётную запись, ни самой учётной записи, ни ограничения на число ваших собственных Mac, которые откроет одна лицензия."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula перевіряє ваш ключ на цьому Mac, без жодного мережевого з’єднання — як і все інше, що вона робить. Тому немає ні входу, ні облікового запису, ні обмеження на кількість ваших власних Mac, які відкриє одна ліцензія."
          }
        }
      }
    },

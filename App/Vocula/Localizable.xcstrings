    "meeting.callEndOffer.named" : {
      "comment" : "Question in a small panel at the top right of the screen while a meeting records, when the app of a call heard during the recording has not used the microphone for 30 seconds, which Vocula takes for the end of the call. The argument is the app's name, e.g. Zoom or Telegram. Answered by two buttons, Keep Recording and Stop Recording; the panel is about 320 points wide and wraps.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ verwendet das Mikrofon nicht mehr. Meeting-Aufnahme beenden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%@ has stopped using the microphone. Stop recording the meeting?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ha dejado de usar el micrófono. ¿Detener la grabación de la reunión?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ n’utilise plus le micro. Arrêter l’enregistrement de la réunion ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non usa più il microfono. Fermare la registrazione della riunione?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ nie używa już mikrofonu. Zatrzymać nagrywanie spotkania?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ parou de usar o microfone. Parar a gravação da reunião?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ больше не использует микрофон. Остановить запись встречи?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ більше не використовує мікрофон. Зупинити запис зустрічі?"
          }
        }
      }
    },

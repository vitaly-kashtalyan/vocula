    "indicator.deviceChanged" : {
      "comment" : "Shown in the indicator strip when the microphone stops mid-session. Drawn on the indicator strip, which clamps at three lines; IndicatorChipSizeTests measures every locale against it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Mikrofon lieferte kein Audio mehr. Das Aufgenommene wurde transkribiert; drücken Sie die Taste erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The microphone stopped delivering audio. What was recorded was transcribed; press the key to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El micrófono dejó de entregar audio. Lo grabado se transcribió; pulsa la tecla para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le microphone a cessé de fournir de l’audio. Ce qui était enregistré a été transcrit ; appuyez de nouveau sur la touche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il microfono ha smesso di fornire audio. Quanto registrato è stato trascritto; premi di nuovo il tasto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mikrofon przestał dostarczać dźwięk. Nagranie zostało rozpoznane; naciśnij klawisz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O microfone parou de entregar áudio. O que foi gravado foi transcrito; pressione a tecla de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Микрофон перестал отдавать звук. Записанное распознано; нажмите клавишу ещё раз."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мікрофон перестав віддавати звук. Записане розпізнано; натисніть клавішу ще раз."
          }
        }
      }
    },

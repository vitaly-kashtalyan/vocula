    "onboarding.updateAutomatically" : {
      "comment" : "Switch on the Permissions screen, beside 'Open at login'. Apple's own wording for this setting. Vocula asks GitHub once a day and fetches the update in the background, so Install is a local act that cannot fail for want of a network. It still INSTALLS nothing on its own — that needs the reader, and the footer says so. Not a macOS permission; it is our setting.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Neue Updates bei Verfügbarkeit laden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Download new updates when available"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descargar actualizaciones nuevas cuando estén disponibles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Télécharger les nouvelles mises à jour lorsqu’elles sont disponibles"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scarica i nuovi aggiornamenti quando disponibili"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pobieraj nowe uaktualnienia, gdy są dostępne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baixar novas atualizações quando disponíveis"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загружать обновления, если они доступны"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Завантажувати нові оновлення, коли вони доступні"
          }
        }
      }
    },
    "onboarding.updateAvailable" : {
      "comment" : "Row label on the Permissions screen once a check has FOUND a newer version, in place of 'Last checked'. The argument is the new version number. It is the only place the app says an update is waiting after the update window has been closed, so it must read as news rather than as a status.",

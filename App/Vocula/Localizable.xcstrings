        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La qualité de reconnaissance varie beaucoup d’une langue à l’autre. L’anglais est celle sur laquelle cette app a été mesurée."
          }
        },
        "it" : {
          "stringUnit" : {

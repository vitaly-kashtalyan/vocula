        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda wypowiedź jest porównywana z językami poniżej i rozpoznawana w tym, który uzyska najwyższy wynik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",

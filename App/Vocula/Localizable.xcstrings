    "diagnostics.clear.message" : {
      "comment" : "Confirmation dialog body.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alles bisher Aufgezeichnete wird verworfen. Nützlich, bevor Sie ein Problem nachstellen, damit der Bericht nur enthält, was währenddessen passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything recorded so far is discarded. Useful before reproducing a problem, so the report carries only what happened while it went wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se descarta todo lo registrado hasta ahora. Útil antes de reproducir un problema, para que el informe contenga solo lo que ocurrió mientras fallaba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tout ce qui a été consigné jusqu’ici est abandonné. Utile avant de reproduire un problème, pour que le rapport ne contienne que ce qui s’est passé pendant l’incident."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tutto ciò che è stato registrato finora viene scartato. Utile prima di riprodurre un problema, così il rapporto contiene solo quanto è accaduto durante il guasto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wszystko, co zapisano dotąd, zostaje odrzucone. Przydatne przed odtworzeniem problemu, aby raport zawierał tylko to, co działo się podczas awarii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tudo o que foi registrado até agora é descartado. Útil antes de reproduzir um problema, para que o relatório contenha só o que aconteceu durante a falha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Всё записанное до сих пор будет отброшено. Полезно перед тем, как воспроизвести проблему: тогда отчёт содержит только то, что происходило во время сбоя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Усе записане досі буде відкинуто. Корисно перед відтворенням проблеми: тоді звіт містить лише те, що відбувалося під час збою."
          }
        }
      }
    },

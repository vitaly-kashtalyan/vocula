    "meeting.status.autoStopSoon" : {
      "comment" : "Menu line in the last minute before the silence stop; also spoken by VoiceOver when it appears. Drawn on one menu line that does not wrap: a longer translation widens the whole menu, so keep it as short as the meaning allows.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seit 14 Minuten ist nichts zu hören. Die Aufnahme endet in einer Minute, wenn kein Ton kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing has been heard for 14 minutes. The recording stops in a minute unless there is sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se oye nada desde hace 14 minutos. La grabación se detendrá en un minuto si no hay sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rien n’a été entendu depuis 14 minutes. L’enregistrement s’arrêtera dans une minute s’il n’y a pas de son."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non si sente nulla da 14 minuti. La registrazione si fermerà tra un minuto se non c’è audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Od 14 minut nic nie słychać. Nagrywanie zatrzyma się za minutę, jeśli nie pojawi się dźwięk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nada foi ouvido nos últimos 14 minutos. A gravação para em um minuto se não houver som."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уже 14 минут ничего не слышно. Если звука не будет, через минуту запись остановится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Уже 14 хвилин нічого не чути. Якщо звуку не буде, за хвилину запис зупиниться."
          }
        }
      }
    },
    "meeting.status.autoStopped" : {
      "comment" : "Menu line after the meeting ended, shown until Dismiss or the next recording; also spoken by VoiceOver when it appears. Drawn on one menu line that does not wrap: a longer translation widens the whole menu, so keep it as short as the meaning allows.",

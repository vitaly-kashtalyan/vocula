        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esperando permiso para grabar otras apps. Responde al diálogo de macOS; mientras tanto, se graba tu micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "En attente de l’autorisation d’enregistrer les autres apps. Répondez à la demande de macOS ; votre micro est enregistré en attendant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In attesa del permesso di registrare le altre app. Rispondi alla finestra di macOS; nel frattempo viene registrato il tuo microfono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Oczekiwanie na zgodę na nagrywanie innych programów. Odpowiedz w oknie macOS; w międzyczasie nagrywany jest twój mikrofon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aguardando permissão para gravar outros apps. Responda à caixa de diálogo do macOS; enquanto isso, seu microfone é gravado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ожидание разрешения на запись других программ. Ответьте на запрос macOS; тем временем записывается ваш микрофон."

    "appearance.language.explained" : {
      "comment" : "Footer distinguishing the interface language from the dictation languages. Languages is this app's own section name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das ist die Sprache, in der Voculas eigene Fenster geschrieben sind. Was es transkribieren kann, ist davon getrennt und steht unter Sprachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is the language Vocula's own windows are written in. What it can transcribe is separate, and lives in Languages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este es el idioma en que están escritas las ventanas de Vocula. Lo que puede transcribir es aparte y está en Idiomas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "C’est la langue dans laquelle les fenêtres de Vocula sont écrites. Ce qu’il sait transcrire est distinct et se trouve dans Langues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa è la lingua in cui sono scritte le finestre di Vocula. Ciò che sa trascrivere è separato e si trova in Lingue."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To język, w którym napisane są okna Vocula. To, co potrafi rozpoznać, jest osobne i znajduje się w Językach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este é o idioma em que as janelas do Vocula estão escritas. O que ele consegue transcrever é separado e fica em Idiomas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это язык, на котором написаны окна Vocula. То, что он умеет распознавать, — это другое, и находится в разделе «Языки»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це мова, якою написані вікна Vocula. Те, що він уміє розпізнавати, — це інше, і міститься в розділі «Мови»."
          }
        }
      }
    },

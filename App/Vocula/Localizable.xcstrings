    "licence.remove.message" : {
      "comment" : "Confirmation dialog body. The daily number must agree with TrialPolicy.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula geht hier auf zehn Diktate pro Tag zurück. Sie können den Schlüssel jederzeit wieder einsetzen — er steht in Ihrer Rechnung, und dies ist der einzige Ort, an dem er gespeichert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vocula will go back to ten dictations a day here. You can paste the key again at any time — it is in your receipt, and this is the only place it is stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula volverá aquí a diez dictados al día. Puedes pegar la clave de nuevo cuando quieras: está en tu recibo, y este es el único sitio donde se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula reviendra ici à dix dictées par jour. Vous pouvez recoller la clé à tout moment — elle est dans votre reçu, et c’est le seul endroit où elle est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula tornerà qui a dieci dettature al giorno. Puoi incollare di nuovo la chiave in qualsiasi momento: è nella tua ricevuta, e questo è l’unico posto in cui viene conservata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula wróci tutaj do dziesięciu dyktowań dziennie. Klucz możesz wkleić ponownie w każdej chwili — jest w Twoim paragonie, a to jedyne miejsce, w którym jest przechowywany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Vocula voltará aqui a dez ditados por dia. Você pode colar a chave de novo quando quiser — ela está no seu recibo, e este é o único lugar onde fica guardada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula вернётся здесь к десяти диктовкам в день. Ключ можно вставить снова в любой момент — он есть в вашем чеке, и это единственное место, где он хранится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula повернеться тут до десяти диктувань на день. Ключ можна вставити знову будь-коли — він є у вашому чеку, і це єдине місце, де він зберігається."
          }
        }
      }
    },

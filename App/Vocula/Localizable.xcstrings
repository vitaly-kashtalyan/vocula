    "keyboard.collides" : {
      "comment" : "The argument is a macOS Keyboard Shortcuts row name, which comes from the glossary. The second sentence is deliberate: this is a warning, not a refusal.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kollidiert mit einem Systemkurzbefehl: %@. Sie können sie trotzdem zuweisen — wessen Taste wichtiger ist, entscheiden Sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Collides with a system shortcut: %@. You can still assign it — whose key matters more is your call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coincide con un atajo del sistema: %@. Puedes asignarla igualmente: de quién es la tecla lo decides tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entre en conflit avec un raccourci système : %@. Vous pouvez l’affecter quand même — à qui revient la touche, c’est vous qui en décidez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "È in conflitto con una scorciatoia di sistema: %@. Puoi assegnarla comunque: a chi spetti il tasto lo decidi tu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koliduje ze skrótem systemowym: %@. Możesz go i tak przypisać — czyj to klawisz, decydujesz Ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conflita com um atalho do sistema: %@. Você pode atribuir mesmo assim — de quem é a tecla, quem decide é você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Конфликтует с системным сокращением: %@. Назначить всё равно можно — чья клавиша важнее, решаете вы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Конфліктує із системним скороченням: %@. Призначити все одно можна — чия клавіша важливіша, вирішуєте ви."
          }
        }
      }
    },
    "keyboard.hold" : {
      "comment" : "The argument is a key chord such as fn or ⌃⇧L, which is never translated. Esc is a key name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halten Sie %@ und sprechen Sie; beim Loslassen wird der Text eingefügt. Esc bricht ab. Die Sprachtaste geht durch die von Ihnen gewählten Sprachen und durch die automatische Erkennung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold %@ and speak; let go and the text is inserted. Esc cancels. The language key steps through the languages you have selected and through automatic detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén %@ y habla; al soltar se inserta el texto. Esc cancela. La tecla de idioma recorre los idiomas que has seleccionado y la detección automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Maintenez %@ et parlez ; relâchez et le texte est inséré. Esc annule. La touche de langue parcourt les langues que vous avez sélectionnées ainsi que la détection automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tieni premuto %@ e parla; al rilascio il testo viene inserito. Esc annulla. Il tasto lingua scorre le lingue che hai selezionato e il rilevamento automatico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przytrzymaj %@ i mów; po zwolnieniu tekst zostaje wstawiony. Esc anuluje. Klawisz języka przechodzi przez wybrane przez Ciebie języki oraz przez wykrywanie automatyczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantenha %@ e fale; ao soltar, o texto é inserido. Esc cancela. A tecla de idioma percorre os idiomas que você selecionou e a detecção automática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удерживайте %@ и говорите; отпустите — текст вставится. Esc отменяет. Клавиша языка перебирает выбранные вами языки и автоопределение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Утримуйте %@ і говоріть; відпустіть — текст вставиться. Esc скасовує. Клавіша мови перебирає обрані вами мови та автовизначення."
          }
        }
      }
    },
    "keyboard.noKeyArrived" : {
      "comment" : "Shown when a capture timed out with nothing. Test is this screen's own button label; Accessibility is macOS's pane name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine Taste kam an. Bedienungshilfen sind womöglich aus, oder eine andere App nimmt die Tasten zuerst — versuchen Sie „Prüfen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No key arrived. Accessibility may be off, or another app is taking keys first — try Test."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No llegó ninguna tecla. Puede que la Accesibilidad esté desactivada, o que otra app se quede las teclas antes — prueba con Probar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucune touche n’est arrivée. L’Accessibilité est peut-être désactivée, ou une autre app prend les touches avant — essayez Tester."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è arrivato alcun tasto. L'accessibilità potrebbe essere disattivata, oppure un’altra app prende i tasti prima — prova con Prova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Żaden klawisz nie dotarł. Dostępność może być wyłączona albo inny program przechwytuje klawisze wcześniej — spróbuj Sprawdź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma tecla chegou. A Acessibilidade pode estar desligada, ou outro app está pegando as teclas antes — tente Testar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавиша не дошла. Возможно, выключен Универсальный доступ, или другая программа забирает клавиши первой — нажмите «Проверить»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Клавіша не дійшла. Можливо, вимкнено Доступність, або інша програма забирає клавіші першою — натисніть «Перевірити»."
          }
        }
      }
    },
    "keyboard.notSaved" : {
      "comment" : "Precedes a refusal sentence of its own. TWO sentences, never a prefix glued to a fragment.",

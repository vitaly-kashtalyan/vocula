    "onboarding.placement.diskImage.footer" : {
      "comment" : "Footer under the warning at the top of the Permissions screen that Vocula runs straight from its disk image; wraps over several lines. Vocula is the app's name and is never translated. \"disk image\" is the Finder's own term. Applications is the folder's name as the Finder shows it in this language (de Programme, ru Программы). \"Quit\" is the app menu's own verb.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Von hier aus lässt es sich nicht aktualisieren, und es ist verschwunden, sobald das Disk-Image ausgeworfen oder der Mac neu gestartet wird. Beenden Sie Vocula, ziehen Sie es in „Programme“ und öffnen Sie es dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It cannot be updated from here, and it is gone once the disk image is ejected or the Mac restarts. Quit Vocula, drag it into Applications, and open it from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desde aquí no se puede actualizar, y desaparece en cuanto se expulsa la imagen de disco o se reinicia el Mac. Sal de Vocula, arrástrala a Aplicaciones y ábrela desde allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elle ne peut pas être mise à jour depuis cet emplacement, et elle disparaît dès que l’image disque est éjectée ou que le Mac redémarre. Quittez Vocula, faites-la glisser dans Applications, puis ouvrez-la depuis cet emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Da qui non può essere aggiornata e sparisce non appena l’immagine disco viene espulsa o il Mac si riavvia. Esci da Vocula, trascinala in Applicazioni e aprila da lì."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stąd nie da się jej uaktualnić, a zniknie po wysunięciu obrazu dysku lub ponownym uruchomieniu Maca. Zakończ Vocula, przeciągnij ją do folderu Aplikacje i otwórz ją stamtąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Daqui ele não pode ser atualizado e some assim que a imagem de disco é ejetada ou o Mac é reiniciado. Encerre o Vocula, arraste-o para Aplicativos e abra-o de lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Отсюда её нельзя обновить, а после извлечения образа или перезагрузки Mac её не станет. Завершите Vocula, перетащите её в «Программы» и откройте оттуда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Звідси її не можна оновити, а після вилучення образу або перезапуску Mac її не стане. Завершіть Vocula, перетягніть її до «Програм» і відкрийте звідти."
          }
        }
      }
    },
    "onboarding.placement.diskImage.title" : {
      "comment" : "Title of a warning at the top of the Permissions screen, shown only when Vocula runs straight from its disk image; it may wrap onto a second line. Vocula is the app's name and is never translated. \"disk image\" is the Finder's own term for a .dmg in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula läuft direkt vom Disk-Image"
          }
        },
        "en" : {
          "stringUnit" : {

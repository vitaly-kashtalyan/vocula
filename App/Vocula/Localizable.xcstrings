    "meeting.status.noSystemAudioYet" : {
      "comment" : "Menu line after a minute without any sound from other apps; worded to be true whether or not permission was denied. \"System Audio Recording\" and \"Privacy & Security\" are Apple's names: write them as a Mac set to this language shows them (see Localization/glossary.md). Also spoken by VoiceOver. Drawn on one menu line that does not wrap: a longer translation widens the whole menu, so keep it as short as the meaning allows.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula hat noch keine andere App gehört. Ist in Ihrem Anruf Ton zu hören, prüfen Sie System Audio Recording unter Privacy & Security."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vocula hasn't heard any other app yet. If your call has sound, check System Audio Recording in Privacy & Security."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula aún no ha oído ninguna otra app. Si tu llamada tiene sonido, revisa System Audio Recording en Privacy & Security."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vocula n’a encore entendu aucune autre app. Si votre appel a du son, vérifiez System Audio Recording dans Privacy & Security."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",

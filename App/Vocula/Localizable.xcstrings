    "onboarding.typing.caveat" : {
      "comment" : "States the study's limits. Transcription, not composition.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie haben Text abgeschrieben statt ihn zu verfassen, und sie waren aus eigenem Antrieb zu einem Tipptest gekommen, sind also schnell. Nehmen Sie es als Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "They were copying text rather than composing it, and they had come to a typing test of their own accord, so they are quick. Treat it as an estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copiaban un texto en lugar de redactarlo, y habían acudido por su cuenta a una prueba de mecanografía, así que son rápidos. Tómalo como una estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ils recopiaient un texte au lieu de le composer, et ils étaient venus d’eux-mêmes à un test de frappe : ils sont donc rapides. Prenez-le comme une estimation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copiavano un testo invece di comporlo, ed erano arrivati di loro iniziativa a un test di digitazione: quindi sono veloci. Prendilo come una stima."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przepisywali tekst, zamiast go układać, i przyszli na test pisania z własnej woli, więc są szybcy. Traktuj to jako oszacowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eles copiavam um texto em vez de compor, e tinham ido a um teste de digitação por vontade própria, então são rápidos. Considere isso uma estimativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Они переписывали готовый текст, а не сочиняли его, и пришли на тест печати по своей воле, то есть они быстрые. Считайте это оценкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вони переписували готовий текст, а не складали його, і прийшли на тест друку з власної волі, тобто вони швидкі. Вважайте це оцінкою."
          }
        }
      }
    },
    "onboarding.typing.counts" : {
      "comment" : "Says what the figure totals. Only inserted dictations count.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zählt jedes Diktat, das die Einfügemarke erreicht hat, so weit der Verlauf zurückreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Counts every dictation that reached the caret, as far back as the history goes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuenta cada dictado que llegó al cursor, hasta donde alcanza el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compte chaque dictée arrivée au curseur, aussi loin que remonte l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conta ogni dettatura arrivata al cursore, fin dove arriva la cronologia."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Liczy każde dyktowanie, które dotarło do kursora, tak daleko, jak sięga historia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conta cada ditado que chegou ao cursor, até onde o histórico alcança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Считает каждую диктовку, дошедшую до курсора, на всю глубину истории."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рахує кожне диктування, що дійшло до курсора, на всю глибину історії."
          }
        }
      }
    },
    "onboarding.typing.rate" : {
      "comment" : "Arguments are a words-per-minute rate and a characters-per-word figure, both fixed constants.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wie lange derselbe Text auf einer Tastatur dauern würde, bei %1$lld Wörtern pro Minute — wobei ein Wort %2$lld Zeichen sind, wie die Tippgeschwindigkeit seit jeher gezählt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How long the same text would take at a keyboard, at %1$lld words a minute — a word being %2$lld characters, which is how typing speed has always been counted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuánto tardaría el mismo texto en un teclado, a %1$lld palabras por minuto, siendo una palabra %2$lld caracteres, que es como siempre se ha contado la velocidad de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combien de temps le même texte prendrait au clavier, à %1$lld mots par minute — un mot valant %2$lld caractères, comme on a toujours compté la vitesse de frappe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto tempo richiederebbe lo stesso testo su una tastiera, a %1$lld parole al minuto — dove una parola è %2$lld caratteri, come si è sempre contata la velocità di digitazione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ile ten sam tekst zająłby na klawiaturze przy %1$lld słowach na minutę — gdzie słowo to %2$lld znaków, jak zawsze liczono szybkość pisania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quanto o mesmo texto levaria num teclado, a %1$lld palavras por minuto — sendo uma palavra %2$lld caracteres, que é como a velocidade de digitação sempre foi contada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сколько тот же текст занял бы на клавиатуре при %1$lld словах в минуту — где слово это %2$lld символов, как скорость печати считали всегда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Скільки той самий текст зайняв би на клавіатурі за %1$lld слів на хвилину — де слово це %2$lld символів, як швидкість друку рахували завжди."
          }
        }
      }
    },
    "onboarding.typing.study" : {
      "comment" : "A citation. The authors' names and the paper's title are proper nouns and are NOT translated; the paper's title keeps its own quotation marks.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diese Rate ist der Durchschnitt über 168 000 Menschen in Dhakal, Feit, Kristensson und Oulasvirta, „Observations on Typing from 136 Million Keystrokes“, CHI 2018 — die größte Messung, die es für eine gewöhnliche Tastatur gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That rate is the average across 168 000 people in Dhakal, Feit, Kristensson and Oulasvirta, “Observations on Typing from 136 Million Keystrokes”, CHI 2018 — the largest measurement there is for an ordinary keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esa velocidad es la media de 168 000 personas en Dhakal, Feit, Kristensson y Oulasvirta, «Observations on Typing from 136 Million Keystrokes», CHI 2018, la mayor medición que existe para un teclado corriente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ce rythme est la moyenne sur 168 000 personnes dans Dhakal, Feit, Kristensson et Oulasvirta, « Observations on Typing from 136 Million Keystrokes », CHI 2018 — la plus grande mesure existante pour un clavier ordinaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quel ritmo è la media su 168 000 persone in Dhakal, Feit, Kristensson e Oulasvirta, «Observations on Typing from 136 Million Keystrokes», CHI 2018 — la più ampia misurazione esistente per una tastiera comune."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To tempo jest średnią z 168 000 osób w pracy Dhakal, Feit, Kristensson i Oulasvirta, „Observations on Typing from 136 Million Keystrokes”, CHI 2018 — największym pomiarze, jaki istnieje dla zwykłej klawiatury."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Essa taxa é a média entre 168 000 pessoas em Dhakal, Feit, Kristensson e Oulasvirta, “Observations on Typing from 136 Million Keystrokes”, CHI 2018 — a maior medição que existe para um teclado comum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эта скорость — среднее по 168 000 человек в работе Dhakal, Feit, Kristensson и Oulasvirta, «Observations on Typing from 136 Million Keystrokes», CHI 2018 — крупнейшем измерении для обычной клавиатуры."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ця швидкість — середнє по 168 000 людей у праці Dhakal, Feit, Kristensson та Oulasvirta, «Observations on Typing from 136 Million Keystrokes», CHI 2018 — найбільшому вимірюванні для звичайної клавіатури."
          }
        }
      }
    },

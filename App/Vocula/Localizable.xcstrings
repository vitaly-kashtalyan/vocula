    "languages.pinnedExplained" : {
      "comment" : "⌃⇧L is a key chord and is never translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der gefüllte Kreis ist die Sprache, in der jede Äußerung transkribiert wird. Die anderen bleiben in der Liste: ⌃⇧L geht durch sie und durch die automatische Erkennung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The filled circle is the language every phrase is transcribed in. The others stay in the list: ⌃⇧L steps through them, and through automatic detection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El círculo relleno es el idioma en el que se transcribe cada frase. Los demás siguen en la lista: ⌃⇧L los recorre, y también la detección automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le cercle plein est la langue dans laquelle chaque phrase est transcrite. Les autres restent dans la liste : ⌃⇧L les parcourt, ainsi que la détection automatique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il cerchio pieno è la lingua in cui viene trascritta ogni frase. Le altre restano nell’elenco: ⌃⇧L le scorre, insieme al rilevamento automatico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wypełnione kółko to język, w którym rozpoznawana jest każda wypowiedź. Pozostałe zostają na liście: ⌃⇧L przechodzi przez nie oraz przez wykrywanie automatyczne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O círculo preenchido é o idioma em que cada frase é transcrita. Os outros continuam na lista: ⌃⇧L percorre eles e também a detecção automática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Закрашенный кружок — язык, на котором распознаётся каждая фраза. Остальные остаются в списке: ⌃⇧L перебирает их и автоопределение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Зафарбоване коло — мова, якою розпізнається кожна фраза. Решта лишається в списку: ⌃⇧L перебирає їх і автовизначення."
          }
        }
      }
    },
    "languages.qualityVaries" : {
      "comment" : "An honesty note. English being the measured language is a fact about this app, and stays true in every translation.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Erkennungsqualität unterscheidet sich stark zwischen den Sprachen. Englisch ist die Sprache, an der diese App gemessen wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recognition quality varies a great deal between languages. English is the one this app has been measured on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La calidad del reconocimiento varía mucho entre idiomas. El inglés es aquel con el que se ha medido esta app."
          }

    "meeting.status.waitingForPermission" : {
      "comment" : "Menu line while macOS's own System Audio Recording dialog is unanswered; also spoken by VoiceOver when it appears. Drawn on one menu line that does not wrap: a longer translation widens the whole menu, so keep it as short as the meaning allows.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Warten auf die Erlaubnis, andere Apps aufzunehmen. Beantworten Sie den macOS-Dialog; Ihr Mikrofon wird währenddessen aufgenommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Waiting for permission to record other apps. Answer the macOS dialog; your microphone is recorded meanwhile."

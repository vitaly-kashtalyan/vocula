          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Каждая фраза сравнивается с языками ниже и распознаётся на том, что набрал больше очков."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",

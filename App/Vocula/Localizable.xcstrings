    "onboarding.typing.caveat" : {
      "comment" : "States the study's limits. Transcription, not composition.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sie haben Text abgeschrieben statt ihn zu verfassen, und sie waren aus eigenem Antrieb zu einem Tipptest gekommen, sind also schnell. Nehmen Sie es als Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "They were copying text rather than composing it, and they had come to a typing test of their own accord, so they are quick. Treat it as an estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copiaban un texto en lugar de redactarlo, y habían acudido por su cuenta a una prueba de mecanografía, así que son rápidos. Tómalo como una estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ils recopiaient un texte au lieu de le composer, et ils étaient venus d’eux-mêmes à un test de frappe : ils sont donc rapides. Prenez-le comme une estimation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Copiavano un testo invece di comporlo, ed erano arrivati di loro iniziativa a un test di digitazione: quindi sono veloci. Prendilo come una stima."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przepisywali tekst, zamiast go układać, i przyszli na test pisania z własnej woli, więc są szybcy. Traktuj to jako oszacowanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eles copiavam um texto em vez de compor, e tinham ido a um teste de digitação por vontade própria, então são rápidos. Considere isso uma estimativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Они переписывали готовый текст, а не сочиняли его, и пришли на тест печати по своей воле, то есть они быстрые. Считайте это оценкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вони переписували готовий текст, а не складали його, і прийшли на тест друку з власної волі, тобто вони швидкі. Вважайте це оцінкою."
          }
        }
      }
    },
    "onboarding.typing.counts" : {
